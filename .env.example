# DB
# POSTGRES_USER é o superusuario de bootstrap, so o initdb usa, o backend nao
POSTGRES_DB=e2ee_chat
POSTGRES_USER=app
POSTGRES_PASSWORD=troque-esta-senha

# Roles criadas em db/init/02_roles.sql
# !!! Usar senhas diferentes
DB_ADMIN_PASSWORD=troque-esta-senha-admin
APP_API_PASSWORD=troque-esta-senha-api
AUDITOR_PASSWORD=troque-esta-senha-auditor

# Backend
# A API conecta como app_api (so DML) e as migrations conectam como db_admin (DDL)
DATABASE_URL=postgresql://app_api:troque-esta-senha-api@db:5432/e2ee_chat
MIGRATION_DATABASE_URL=postgresql://db_admin:troque-esta-senha-admin@db:5432/e2ee_chat

# Segredo de assinatura dos JWT
# Gere com -> python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-este-segredo
JWT_ISSUER=e2ee-chat
JWT_AUDIENCE=e2ee-chat-web
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Chave que cifra o totp_secret
# Gere com -> python -c "import secrets; print(secrets.token_urlsafe(32))"
TOTP_ENCRYPTION_KEY=troque-esta-chave-totp

# Admin inicial, criado por python -m app.seed
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha-do-admin

# Origens permitidas no CORS 
CORS_ORIGINS=http://localhost:5173

# Limites contra DoS
MAX_BODY_BYTES=65536
MAX_WS_FRAME_BYTES=131072
MAX_WS_TOTAL=100
MAX_PAGE_SIZE=100
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10
APP_API_CONNECTION_LIMIT=20
APP_API_STATEMENT_TIMEOUT=5s

# Frontend
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
